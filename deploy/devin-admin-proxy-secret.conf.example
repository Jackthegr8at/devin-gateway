# Per-install admin proxy secret, included by deploy/nginx-devin-admin.conf.
# Install on the Nginx host only: /etc/nginx/devin-admin-proxy-secret.conf (root:root, mode 0600).
# The value must equal the gateway's settings-volume file admin-proxy-secret.
# Copy it without echoing it. See deploy/ADMIN_HTTPS.md, "Management write secret".
# Never commit the real value. This template holds only a placeholder.
proxy_set_header X-Devin-Admin-Proxy "__REPLACE_ON_NGINX_HOST__";
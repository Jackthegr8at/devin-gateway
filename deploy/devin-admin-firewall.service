# Adapt the private IPv4 arguments to match 20-devin-admin-firewall.conf.
[Unit]
Description=Restrict Devin management publication to the Nginx host
After=ufw.service
Requires=ufw.service
Before=docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/devin-admin-firewall 192.0.2.10 192.0.2.20
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target

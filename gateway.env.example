# Bind only to a private LAN or WireGuard address configured on this host.
# This file intentionally contains no credentials.
DEVIN_GATEWAY_BIND_IP=
# Experimental SWE-2 completion-marker protocol; disabled by default.
# Set to 1 only for operator-monitored testing. There is no continuation limit.
DEVIN_SWE_AUTONOMOUS_CONTINUATION=0
# Management uses the same private bind on 38644. Install the source-restricted
# Docker firewall first; only the separate Nginx host may access this port.
# Browser ACL and Basic authentication live on that Nginx host, not in .env.
